    def Scope "joints"
    {
        def PhysicsFixedJoint "root_joint"
        {
            rel physics:body1 = </stock_arm/Base_Plate>
            point3f physics:localPos0 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsFixedJoint "Motor_Mount"
        {
            rel physics:body0 = </stock_arm/Base_Plate>
            rel physics:body1 = </stock_arm/Yaw_Motor>
            point3f physics:localPos0 = (0, 0, 0.00635)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
        def PhysicsRevoluteJoint "Base_Yaw" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            rel physics:body0 = </stock_arm/Yaw_Motor>
            rel physics:body1 = </stock_arm/Upper_Arm>
            point3f physics:localPos0 = (0, 0, 0.048)
            quatf physics:localRot0 = (1, 0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            uniform token physics:axis = "Z"
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:stiffness = 1.745329
            float drive:angular:physics:damping = 0.1745329
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            float physxJoint:maxJointVelocity = 360
        }
        def PhysicsRevoluteJoint "Shoulder" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysxJointAPI"]
        )
        {
            rel physics:body0 = </stock_arm/Upper_Arm>
            rel physics:body1 = </stock_arm/Forearm>
            point3f physics:localPos0 = (0.01, 0, 0.165)
            quatf physics:localRot0 = (0.5, 0.5, 0.5, 0.5)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            uniform token physics:axis = "Z"
            float physics:lowerLimit = -120
            float physics:upperLimit = 120
            uniform token drive:angular:physics:type = "force"
            float drive:angular:physics:stiffness = 1.745329
            float drive:angular:physics:damping = 0.1745329
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:targetPosition = 0
            float drive:angular:physics:targetVelocity = 0
            float physxJoint:maxJointVelocity = 360
        }
        def PhysicsFixedJoint "Wrist_Mount"
        {
            rel physics:body0 = </stock_arm/Forearm>
            rel physics:body1 = </stock_arm/Wrist_Servo>
            point3f physics:localPos0 = (0, 0.125, 0.01)
            quatf physics:localRot0 = (0.5, -0.5, -0.5, -0.5)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

